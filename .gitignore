# === MIS-QMS .gitignore ===
# ИНВАРИАНТ: реальные данные отклонений (WO, номера деталей, ивритские
# заключения) НИКОГДА не попадают в git. База автономна (RULES §5).

# --- Данные / импорты (автономны, вне репо) ---
data/
imports/
*.xlsx
*.xls
*.csv
*.db
*.sqlite
*.sqlite3

# --- Билды / артефакты ---
build/
dist/
out/
*.log

# --- Зависимости ---
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/

# --- Окружение / секреты ---
.env
.env.*
*.local

# --- IDE / ОС ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Чужая выгрузка, не полоса репозитория ---
#
# Каталог с таким именем есть в волте; десктоп-приложение однажды положило сюда
# `CASE_INTAKE_required_information.pdf` (09.09, посреди наряда 0036) — в репо, а
# не в волт. Наряд его не заказывал, код его не создаёт, и уехать с ближайшим
# `git add` он не должен: мост между слоями — git, и класть в него чужое молча
# нельзя (`CLAUDE.md` §3б.3 — на диске нет того, чего наряд не заказывал).
#
# Правило на **каталог**, а не на один файл: повторится — повторится так же.
Claude outputs/
