    "deny": [
      "Write(../Vault_01/**)",
      "Edit(../Vault_01/**)",
      "Bash(rm ../Vault_01/**)",
      "Bash(mv ../Vault_01/**)",
      "mcp__claude_ai_FHA",
      "mcp__claude_ai_FHA__*"
    ],
    "additionalDirectories": [
      "../Vault_01/_system",
      "../Vault_01/90_Shared"
    ]
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai FHA"
    }
  ]
}
